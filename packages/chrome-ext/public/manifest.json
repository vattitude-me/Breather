{
  "manifest_version": 3,
  "name": "Breather",
  "version": "2.0.0",
  "description": "A tiny desk garden that grows each time you stop to breathe. One gentle daily reminder, synced with the Breather web app.",
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://breather-break.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://breather-break.vercel.app/*"
      ],
      "js": [
        "content-sync.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
